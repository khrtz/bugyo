{
  "name": "asset-review",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "check": "tsc --noEmit && eslint . && depcruise src && knip && bugyo task lint",
    "test": "vitest run",
    "e2e": "playwright test",
    "verify": "bugyo verify"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.107.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@bugyo/lint": "workspace:*",
    "@bugyo/lint-react": "workspace:*",
    "@playwright/test": "^1.65.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.12",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "bugyo": "workspace:*",
    "dependency-cruiser": "^18.7.2",
    "eslint": "^10.15.0",
    "jsdom": "^31.0.1",
    "knip": "^6.45.1",
    "typescript": "~6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
