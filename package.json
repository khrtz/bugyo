{
  "name": "bugyo-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.8.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "check": "pnpm -r check",
    "test": "pnpm -r test",
    "e2e": "pnpm --filter todo-app e2e",
    "verify": "pnpm --filter todo-app verify --all",
    "validate-plugin": "claude plugin validate plugin --strict && claude plugin validate . --strict"
  }
}
