{
  "name": "bugyo",
  "version": "0.1.0",
  "description": "エージェント開発の土台: feature map・検証ハーネス・雛形生成CLI",
  "license": "MIT",
  "type": "module",
  "bin": { "bugyo": "./bin/bugyo.js" },
  "exports": {
    ".": { "types": "./src/index.d.ts", "default": "./src/index.js" },
    "./vitest": { "types": "./src/vitest.d.ts", "default": "./src/vitest.js" },
    "./playwright": { "types": "./src/playwright.d.ts", "default": "./src/playwright.js" }
  },
  "files": ["bin", "src", "template"],
  "scripts": {
    "sync-template": "node scripts/sync-template.js",
    "prepack": "node scripts/sync-template.js",
    "check": "node --check bin/bugyo.js && node --check src/scaffold.js",
    "test": "node scripts/sync-template.js && node --test \"test/*.test.js\""
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.50",
    "vitest": ">=4"
  }
}
