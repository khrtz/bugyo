{
  "name": "bugyo",
  "version": "0.1.0",
  "description": "Feature map, verification with evidence, task ledger and gate, and scaffolding for agent-written code",
  "keywords": [
    "cli",
    "agents",
    "verification",
    "feature-map",
    "playwright",
    "scaffold"
  ],
  "homepage": "https://github.com/khrtz/bugyo/tree/main/packages/bugyo#readme",
  "bugs": "https://github.com/khrtz/bugyo/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/khrtz/bugyo.git",
    "directory": "packages/bugyo"
  },
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "bin": {
    "bugyo": "./bin/bugyo.js"
  },
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./vitest": {
      "types": "./src/vitest.d.ts",
      "default": "./src/vitest.js"
    },
    "./node-test": {
      "types": "./src/node-test.d.ts",
      "default": "./src/node-test.js"
    },
    "./playwright": {
      "types": "./src/playwright.d.ts",
      "default": "./src/playwright.js"
    }
  },
  "files": [
    "bin",
    "src",
    "template"
  ],
  "scripts": {
    "sync-template": "node scripts/sync-template.js",
    "prepack": "node scripts/sync-template.js",
    "check": "node scripts/check.js",
    "test": "node scripts/sync-template.js && node --test \"test/*.test.js\""
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.50",
    "vitest": ">=4"
  },
  "peerDependenciesMeta": {
    "@playwright/test": {
      "optional": true
    },
    "vitest": {
      "optional": true
    }
  }
}
