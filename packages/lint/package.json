{
  "name": "@bugyo/lint",
  "version": "0.1.0",
  "description": "ESLint, dependency-cruiser, and tsconfig presets that leave agents only the right way to write code",
  "keywords": [
    "eslint",
    "eslint-config",
    "dependency-cruiser",
    "typescript",
    "agents",
    "architecture"
  ],
  "homepage": "https://github.com/khrtz/bugyo/tree/main/packages/lint#readme",
  "bugs": "https://github.com/khrtz/bugyo/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/khrtz/bugyo.git",
    "directory": "packages/lint"
  },
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./eslint.js"
    },
    "./depcruise": "./depcruise.cjs",
    "./tsconfig.json": "./tsconfig.base.json"
  },
  "files": [
    "eslint.js",
    "messages.js",
    "index.d.ts",
    "depcruise.cjs",
    "tsconfig.base.json",
    "rules"
  ],
  "scripts": {
    "check": "node --check eslint.js && node --check messages.js && node --check depcruise.cjs && node --check rules/no-comments.js",
    "test": "node --test \"test/*.test.js\""
  },
  "dependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.18.1",
    "globals": "^17.14.0",
    "typescript-eslint": "^8.72.2"
  },
  "peerDependencies": {
    "@eslint/js": "^9.24.0 || ^10.0.0",
    "dependency-cruiser": ">=18",
    "eslint": "^9.24.0 || ^10.0.0",
    "typescript": ">=5.8 <6.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "dependency-cruiser": "^18.7.2",
    "eslint": "^10.15.0",
    "typescript": "~6.0.3"
  }
}
