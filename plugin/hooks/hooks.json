{
  "description": "完了の判定を決めるファイル（.bugyo/config.json・証拠・ベースライン・タスク台帳の状態）を、エージェントが直接書き換えるのを断る。作業を終える前に bugyo task lint を実行し、落ちたら終わらせない",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|Bash|PowerShell",
        "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/guard.mjs\"" }]
      }
    ],
    "Stop": [
      {
        "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/stop-check.mjs\"" }]
      }
    ]
  }
}
